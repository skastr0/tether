{
  "name": "@skastr0/tether-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "tether": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run test && node --test scripts/release.test.mjs",
    "build:npm-cli": "bun scripts/build-npm-cli.ts",
    "pack:npm-cli": "bun run build:npm-cli && node scripts/pack-npm-cli.mjs",
    "smoke:npm-cli": "node scripts/smoke-npm-cli.mjs \"$PWD/dist/tarballs\""
  },
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "effect": "^3.21.0",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "license": "MIT",
  "description": "Collocated doctrine with structural git+AST facts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/tether.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
