#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

locate_orb_setup() {
  local candidate
  for candidate in \
    "${repo_root}/../repos/orb-setup" \
    "${repo_root}/../repos/skastr0/orb-setup" \
    "${repo_root}/../orb-setup"; do
    if [[ -x "${candidate}/bin/setup.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

install_base_packages() {
  local missing=()
  local package
  for package in git unzip curl ca-certificates; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fqx 'install ok installed'; then
      missing+=("$package")
    fi
  done
  if [[ "${#missing[@]}" -eq 0 ]]; then
    return
  fi
  printf '[setup] Installing base packages: %s\n' "${missing[*]}"
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y git unzip curl ca-certificates
}

install_pinned_bun() {
  local bun_package_manager bun_version
  bun_package_manager="$(node -p 'require("./package.json").packageManager')"
  if [[ "$bun_package_manager" != bun@?* ]]; then
    printf '[setup] error: package.json must declare packageManager as bun@<version>\n' >&2
    exit 1
  fi
  bun_version="${bun_package_manager#bun@}"
  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  if ! command -v bun >/dev/null 2>&1 || [[ "$(bun --version)" != "$bun_version" ]]; then
    printf '[setup] Installing Bun %s\n' "$bun_version"
    curl -fsSL https://bun.sh/install | bash -s -- "bun-v${bun_version}"
  fi
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$BUN_INSTALL/bin/bun" "$HOME/.local/bin/bun"
  export PATH="${BUN_INSTALL}/bin:${HOME}/.local/bin:${PATH}"
  if [[ "$(bun --version)" != "$bun_version" ]]; then
    printf '[setup] error: expected Bun %s, found %s\n' "$bun_version" "$(bun --version)" >&2
    exit 1
  fi
}

install_pinned_node() {
  if command -v node >/dev/null 2>&1 && node -e 'const [a,b] = process.versions.node.split(".").map(Number); process.exit(a > 22 || (a === 22 && b >= 14) ? 0 : 1)'; then
    return
  fi
  local arch version archive staging expected actual
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) printf '[setup] error: unsupported architecture %s\n' "$(uname -m)" >&2; exit 1 ;;
  esac
  version=v24.14.0
  archive="node-${version}-linux-${arch}.tar.xz"
  staging="$(mktemp -d)"
  printf '[setup] Installing Node %s\n' "$version"
  curl -fsSL "https://nodejs.org/dist/${version}/${archive}" -o "$staging/$archive"
  curl -fsSL "https://nodejs.org/dist/${version}/SHASUMS256.txt" -o "$staging/checksums"
  expected="$(awk -v file="$archive" '$2 == file { print $1 }' "$staging/checksums")"
  actual="$(sha256sum "$staging/$archive" | awk '{ print $1 }')"
  [[ -n "$expected" && "$expected" == "$actual" ]]
  mkdir -p "$HOME/.local/node" "$HOME/.local/bin"
  tar -xJf "$staging/$archive" --strip-components=1 -C "$HOME/.local/node"
  local tool
  for tool in node npm npx; do
    ln -sfn "$HOME/.local/node/bin/$tool" "$HOME/.local/bin/$tool"
  done
  rm -rf "$staging"
}

persist_tool_paths() {
  local marker="# tether toolchain PATH"
  local profile="$HOME/.bash_profile"
  touch "$profile"
  if grep -Fqx "$marker" "$profile" 2>/dev/null; then
    return
  fi
  cat >> "$profile" <<EOF

$marker
export BUN_INSTALL="\$HOME/.bun"
if [ -d "\$BUN_INSTALL/bin" ]; then
  case ":\$PATH:" in
    *":\$BUN_INSTALL/bin:"*) ;;
    *) export PATH="\$BUN_INSTALL/bin:\$PATH" ;;
  esac
fi
if [ -d "\$HOME/.local/bin" ]; then
  case ":\$PATH:" in
    *":\$HOME/.local/bin:"*) ;;
    *) export PATH="\$HOME/.local/bin:\$PATH" ;;
  esac
fi
EOF
}

if [[ "$(uname -s)" == Linux ]]; then
  install_base_packages
fi
install_pinned_node

orb_setup="$(locate_orb_setup)" || {
  printf '[setup] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
printf '[setup] Using shared runtime at %s\n' "$orb_setup"
bash "${orb_setup}/bin/setup.sh"
export PATH="${HOME}/.bun/bin:${HOME}/.local/bin:${PATH}"

install_pinned_bun
persist_tool_paths

printf '[setup] Installing Tether dependencies\n'
bun install --frozen-lockfile
printf '[setup] Orb toolchain ready: Bun %s, Node %s\n' \
  "$(bun --version)" "$(node --version)"
