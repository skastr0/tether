#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"
if ! command -v git >/dev/null || ! command -v unzip >/dev/null || ! command -v curl >/dev/null; then
  sudo apt-get update -qq
  sudo apt-get install -y git unzip curl ca-certificates
fi

if ! command -v bun >/dev/null || [[ "$(bun --version)" != "1.3.14" ]]; then
  curl --fail --silent --show-error --location https://bun.sh/install | bash -s "bun-v1.3.14"
fi

if ! command -v node >/dev/null || ! node -e 'const [a,b] = process.versions.node.split(".").map(Number); process.exit(a > 22 || (a === 22 && b >= 14) ? 0 : 1)'; then
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo "Unsupported orb architecture" >&2; exit 1 ;;
  esac
  version=v24.14.0
  archive="node-${version}-linux-${arch}.tar.xz"
  staging="$(mktemp -d)"
  trap 'rm -rf "$staging"' EXIT
  curl -fsSL "https://nodejs.org/dist/${version}/${archive}" -o "$staging/$archive"
  curl -fsSL "https://nodejs.org/dist/${version}/SHASUMS256.txt" -o "$staging/checksums"
  expected="$(awk -v file="$archive" '$2 == file { print $1 }' "$staging/checksums")"
  [[ -n "$expected" && "$expected" == "$(sha256sum "$staging/$archive" | cut -d ' ' -f 1)" ]]
  mkdir -p "$HOME/.local/node" "$HOME/.local/bin"
  tar -xJf "$staging/$archive" --strip-components=1 -C "$HOME/.local/node"
  for tool in node npm npx; do
    ln -sf "$HOME/.local/node/bin/$tool" "$HOME/.local/bin/$tool"
  done
fi

profile_line='export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"'
touch "$HOME/.bash_profile"
if ! grep -Fqx "$profile_line" "$HOME/.bash_profile"; then
  printf '\n%s\n' "$profile_line" >> "$HOME/.bash_profile"
fi

bun install --frozen-lockfile
printf 'Orb toolchain ready: Bun %s, Node %s\n' "$(bun --version)" "$(node --version)"
# Tests are not a setup gate so a broken suite cannot block orb open.
# Install clients only: authentication belongs in resume, never in a shared snapshot.
printf 'Preparing Tailscale and Quasar clients\n'
sudo install -d /etc/systemd/system/tailscaled.service.d
sudo tee /etc/systemd/system/tailscaled.service.d/amp-orb.conf >/dev/null <<'EOF'
[Service]
Environment=TS_ASSUME_NETWORK_UP_FOR_TEST=true
EOF
if ! command -v tailscale >/dev/null 2>&1; then
  curl -fsSL https://tailscale.com/install.sh | sh
fi
sudo systemctl daemon-reload
# Start a stopped daemon; never restart an already-running one.
sudo systemctl enable --now tailscaled

quasar_version=0.5.3
quasar_package="$HOME/.local/lib/node_modules/@skastr0/quasar-cli/package.json"
if [[ ! -x "$HOME/.local/bin/quasar" ]] ||
   [[ "$(node -p 'require(process.argv[1]).version' "$quasar_package" 2>/dev/null || true)" != "$quasar_version" ]]; then
  npm install --global --prefix "$HOME/.local" "@skastr0/quasar-cli@$quasar_version"
fi
